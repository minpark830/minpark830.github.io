{
  "name": "minpark830.github.io",
  "description": "Minwoo Park's portfolio: an Astro site with a live PID servo simulation, project write-ups, and a tested deploy pipeline.",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.23.4"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "check": "astro check",
    "test:unit": "vitest run --project unit",
    "test:dist": "vitest run --project dist",
    "test:e2e": "playwright test",
    "lhci": "npx --yes @lhci/cli@0.15.1 autorun",
    "test": "npm run check && npm run test:unit && npm run build && npm run test:dist && npm run test:e2e"
  },
  "dependencies": {
    "@astrojs/mdx": "^8.1.2",
    "@astrojs/sitemap": "^3.7.4",
    "astro": "^7.4.4"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "1.63.0",
    "playwright-core": "1.63.0",
    "typescript": "~6.0.3",
    "vitest": "^5.0.5"
  }
}
