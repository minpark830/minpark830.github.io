---
// Figure 1: the live servo. A dark display beside a control panel. The
// controller source on the right is imported from firmware/, the same files
// the unit tests compile.
import { Code } from 'astro:components';
import pidSource from '../../firmware/pid.hpp?raw';
import loopSource from '../../firmware/control_loop.cpp?raw';
import { DEFAULT_GAINS, GAIN_RANGE, REQUIREMENTS, evaluate } from '../lib/servo';

// Render the default response at build time, so the readouts are right
// before any script runs.
const { metrics } = evaluate(DEFAULT_GAINS);
const nb = '\u202f';
const readouts = [
  { id: 'os', label: 'Overshoot', value: `${metrics.overshootPct.toFixed(1)}%`, limit: `limit ${REQUIREMENTS.overshootPct}%` },
  { id: 'ts', label: 'Settling time', value: `${metrics.settlingS?.toFixed(2)}${nb}s`, limit: `to 2%, limit ${REQUIREMENTS.settlingS.toFixed(2)}${nb}s` },
  { id: 'ld', label: 'Error under load', value: `${metrics.loadErrorPct.toFixed(2)}%`, limit: `at 1.1${nb}s, limit ${REQUIREMENTS.loadErrorPct}%` },
];
const gains = [
  { key: 'kp', sub: 'p', name: 'Proportional' },
  { key: 'ki', sub: 'i', name: 'Integral' },
  { key: 'kd', sub: 'd', name: 'Derivative' },
] as const;
const fmt = (key: keyof typeof GAIN_RANGE) => DEFAULT_GAINS[key].toFixed(GAIN_RANGE[key].digits);
---

<figure class="bench" id="bench" aria-labelledby="fig1-cap">
  <div class="bench-grid">
    <div class="scope">
      <div class="annun">
        {readouts.map((r) => (
          <div class="cell pass" id={`req-${r.id}`}>
            <span class="lbl">{r.label}</span>
            <span class="val">
              <span class="num" id={`v-${r.id}`}>{r.value}</span>
              <span class="st">
                <svg viewBox="0 0 12 12" aria-hidden="true"><path class="ic-pass" d="M2 6.5l2.6 2.6L10 3.4"></path><path class="ic-fail" d="M3 3l6 6M9 3l-6 6"></path></svg>
                <span class="st-word">Pass</span>
              </span>
            </span>
            <span class="lim">{r.limit}</span>
          </div>
        ))}
      </div>
      <div class="plot" id="plot">
        <svg id="scope-svg" role="img" viewBox="0 0 640 300" aria-label="Step response over two seconds: the target steps from 0 to 1 radian at 0.1 seconds and back at 1.1 seconds; the measured position follows it, and a load step is applied at 0.6 seconds."></svg>
      </div>
      <div class="scope-foot">
        <div class="legend" aria-hidden="true">
          <span class="lg lg-target">Target</span>
          <span class="lg lg-pos">Position</span>
          <span class="lg lg-ghost" id="lg-ghost" hidden>Previous gains</span>
          <span class="lg lg-cmd">Motor command</span>
        </div>
        <p class="advice ok" id="advice">All three requirements pass.</p>
      </div>
    </div>

    <div class="panel">
      <fieldset class="gains">
        <legend>Controller gains</legend>
        {gains.map((g) => (
          <div class="gain-row">
            <label for={g.key}><span class="sym"><i>K</i><sub>{g.sub}</sub></span><span class="gname">{g.name}</span></label>
            <input type="range" id={g.key} min={GAIN_RANGE[g.key].min} max={GAIN_RANGE[g.key].max} step={GAIN_RANGE[g.key].step} value={DEFAULT_GAINS[g.key]} />
            <output id={`${g.key}-out`} for={g.key}>{fmt(g.key)}</output>
          </div>
        ))}
      </fieldset>

      <div class="opts">
        <label class="check"><input type="checkbox" id="noise" /> Add sensor noise</label>
        <button type="button" class="btn-text" id="reset">Reset gains</button>
      </div>

      <div class="code code-live">
        <div class="code-head"><span class="file">gains.hpp</span><span>follows the sliders</span></div>
        <pre tabindex="0"><code><span class="k">constexpr float</span> kKp = <span class="n" id="c-kp">{fmt('kp')}f</span>;  <span class="c">// u per rad</span>
<span class="k">constexpr float</span> kKi = <span class="n" id="c-ki">{fmt('ki')}f</span>;  <span class="c">// u per rad·s</span>
<span class="k">constexpr float</span> kKd = <span class="n" id="c-kd">{fmt('kd')}f</span>; <span class="c">// u·s per rad</span></code></pre>
      </div>

      <details class="source">
        <summary><span class="when-closed">Show the controller source</span><span class="when-open">Hide the controller source</span></summary>
        <div class="code">
          <div class="code-head"><span class="file">pid.hpp</span><span>C++17, compiled in CI</span></div>
          <Code code={pidSource.trimEnd()} lang="cpp" theme="css-variables" />
        </div>
        <div class="code">
          <div class="code-head"><span class="file">control_loop.cpp</span><span>on an STM32</span></div>
          <Code code={loopSource.trimEnd()} lang="cpp" theme="css-variables" />
        </div>
      </details>
    </div>
  </div>
  <p class="sr-only" id="scope-status" aria-live="polite"></p>
  <figcaption id="fig1-cap">
    <b>Figure 1.</b> A motor-driven position servo under discrete PID control at 1&#8239;kHz, simulated live in your browser,
    with a ±1 actuator limit and a load step at 0.6&#8239;s. Move a gain and the response, the requirement checks, and the
    C++ constants update together. <a href="/projects/servo/" data-astro-prefetch>How the simulation works and how it is tested</a>.
  </figcaption>
</figure>

<style>
  .bench { margin: 48px 0 0; }
  .bench-grid {
    display: grid; grid-template-columns: minmax(0, 7fr) minmax(0, 5fr);
    gap: 28px; align-items: start;
  }
  .scope {
    min-width: 0; padding: 12px 12px 10px;
    background: var(--scr-bg); color: var(--scr-fg);
    border: 1px solid var(--scr-edge); border-radius: var(--radius-lg);
    box-shadow: 0 0 0 1px var(--bg), 0 0 0 2px var(--scr-edge);
  }
  .annun {
    display: grid; grid-template-columns: repeat(3, minmax(0, 1fr));
    border: 1px solid var(--scr-grid-2); border-radius: var(--radius); margin-bottom: 10px;
  }
  .cell { min-width: 0; padding: 8px 10px 9px; display: grid; gap: 1px; }
  .cell + .cell { border-left: 1px solid var(--scr-grid-2); }
  .lbl { font-size: 12px; color: var(--scr-dim); line-height: 1.35; }
  .val { display: flex; flex-wrap: wrap; align-items: baseline; gap: 2px 10px; }
  .num { font: 700 20px/1.25 var(--font-sans); color: var(--scr-fg); white-space: nowrap; font-variant-numeric: tabular-nums; }
  .st { display: inline-flex; align-items: center; gap: 4px; font-size: 12.5px; font-weight: 700; white-space: nowrap; }
  .st svg { width: 11px; height: 11px; fill: none; stroke: currentColor; stroke-width: 2; stroke-linecap: round; stroke-linejoin: round; }
  .lim { font-size: 11.5px; color: var(--scr-dim); line-height: 1.35; }
  .cell.pass .st { color: var(--scr-green); }
  .cell.fail .st, .cell.fail .num { color: var(--scr-amber); }
  .cell.pass .ic-fail, .cell.fail .ic-pass { display: none; }

  .plot { position: relative; }
  .plot svg { display: block; width: 100%; height: auto; overflow: hidden; }
  .plot :global(.g1) { stroke: var(--scr-grid); stroke-width: 1; }
  .plot :global(.g2) { stroke: var(--scr-grid-2); stroke-width: 1; }
  .plot :global(.pframe) { fill: none; stroke: var(--scr-grid-2); stroke-width: 1; }
  .plot :global(.ax) { fill: var(--scr-dim); font: 400 11px var(--font-sans); font-variant-numeric: tabular-nums; }
  .plot :global(.lim-line) { stroke: var(--scr-dim); stroke-width: 1; stroke-dasharray: 2 3; }
  .plot :global(.load-line) { stroke: var(--scr-dim); stroke-width: 1; stroke-dasharray: 4 3; }
  .plot :global(.tr-target) { fill: none; stroke: var(--scr-magenta); stroke-width: 1.6; stroke-dasharray: 6 4; }
  .plot :global(.tr-pos) { fill: none; stroke: var(--scr-green); stroke-width: 2.2; stroke-linejoin: round; }
  .plot :global(.tr-ghost) { fill: none; stroke: var(--scr-green); stroke-width: 2; stroke-opacity: 0.3; stroke-linejoin: round; }
  .plot :global(.tr-cmd) { fill: none; stroke: var(--scr-cmd); stroke-width: 1.3; stroke-linejoin: round; }
  .plot :global(.beam) { fill: var(--scr-green); }

  .scope-foot { display: flex; flex-wrap: wrap; justify-content: space-between; gap: 6px 18px; margin-top: 8px; align-items: baseline; }
  .legend { display: flex; flex-wrap: wrap; gap: 4px 16px; font-size: 12px; color: var(--scr-dim); }
  .lg { display: inline-flex; align-items: center; gap: 7px; white-space: nowrap; }
  .lg::before { content: ''; width: 18px; border-top: 2px solid; }
  .lg-target::before { border-top-style: dashed; border-color: var(--scr-magenta); }
  .lg-pos::before { border-color: var(--scr-green); }
  .lg-ghost::before { border-color: var(--scr-green); opacity: 0.35; }
  .lg-cmd::before { border-color: var(--scr-cmd); border-top-width: 1.5px; }
  .advice { font-size: 12.5px; font-weight: 700; color: var(--scr-amber); margin: 0; }
  .advice.ok { color: var(--scr-green); }

  .panel { min-width: 0; display: grid; gap: 18px; }
  .gains { border: 0; margin: 0; padding: 0; min-width: 0; }
  .gains legend { font-weight: 700; padding: 0; margin-bottom: 4px; }
  .gain-row { display: grid; grid-template-columns: 124px minmax(0, 1fr) 58px; gap: 12px; align-items: center; min-height: 44px; }
  .gain-row label { display: flex; align-items: baseline; gap: 9px; white-space: nowrap; }
  .sym { font-size: 17px; font-weight: 700; }
  .sym i { font-style: italic; font-weight: 400; }
  .sym sub { font-size: 0.68em; font-weight: 700; }
  .gname { font-size: var(--fs-cap); color: var(--fg-3); }
  output { font: 700 16px var(--font-sans); color: var(--sel); text-align: right; font-variant-numeric: tabular-nums; }

  input[type='range'] {
    -webkit-appearance: none; appearance: none; width: 100%; height: 32px; margin: 0;
    background: transparent; cursor: pointer; --pct: 50%;
  }
  input[type='range']::-webkit-slider-runnable-track {
    height: 4px; border-radius: 2px;
    background: linear-gradient(to right, var(--sel) 0 var(--pct), var(--rule) var(--pct) 100%);
  }
  input[type='range']::-webkit-slider-thumb {
    -webkit-appearance: none; appearance: none; width: 12px; height: 22px; margin-top: -9px;
    border-radius: 3px; background: var(--bg); border: 2px solid var(--sel);
  }
  input[type='range']::-moz-range-track { height: 4px; border-radius: 2px; background: var(--rule); }
  input[type='range']::-moz-range-progress { height: 4px; border-radius: 2px; background: var(--sel); }
  input[type='range']::-moz-range-thumb { width: 8px; height: 18px; border-radius: 3px; background: var(--bg); border: 2px solid var(--sel); }
  input[type='range']:focus-visible { outline: 2px solid var(--sel); outline-offset: 2px; }

  .opts { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 10px 20px; }
  .check { display: inline-flex; align-items: center; gap: 9px; font-size: var(--fs-ui); cursor: pointer; }
  .check input { width: 17px; height: 17px; margin: 0; accent-color: var(--sel); }

  .code-live .k { font-weight: 700; }
  .code-live .c { color: var(--fg-3); }
  .code-live .n { color: var(--sel); font-weight: 700; }
  .source summary {
    display: inline-flex; align-items: center; gap: 8px; cursor: pointer;
    font-weight: 700; font-size: var(--fs-ui); color: var(--sel); list-style: none;
  }
  .source summary::-webkit-details-marker { display: none; }
  .source summary::before {
    content: ''; width: 7px; height: 7px; border-right: 2px solid currentColor; border-bottom: 2px solid currentColor;
    transform: rotate(-45deg); transition: transform 0.15s;
  }
  .source[open] summary::before { transform: rotate(45deg); }
  .source .when-open, .source[open] .when-closed { display: none; }
  .source[open] .when-open { display: inline; }
  .source > .code { margin-top: 12px; }

  figcaption { margin-top: 14px; }

  @media (max-width: 1040px) {
    .bench-grid { grid-template-columns: minmax(0, 1fr); }
    .panel { grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); column-gap: 28px; align-items: start; }
    .gains, .opts { grid-column: 1; }
    .code-live, .source { grid-column: 2; }
    .code-live { grid-row: 1; }
    .source { grid-row: 2 / span 2; }
  }
  @media (max-width: 900px) {
    .panel { grid-template-columns: minmax(0, 1fr); }
    .code-live, .source, .gains, .opts { grid-column: 1; grid-row: auto; }
  }
  @media (max-width: 640px) {
    .bench { margin-top: 32px; }
    .scope { padding: 8px; }
    .cell { padding: 6px 7px 7px; }
    .num { font-size: 16px; }
    .lbl { font-size: 11px; }
    .lim { font-size: 10.5px; }
    .st-word { display: none; }
    .gain-row { grid-template-columns: 44px minmax(0, 1fr) 54px; }
    .gname { display: none; }
  }
  @media print {
    .panel, .scope-foot { display: none; }
    .bench-grid { grid-template-columns: minmax(0, 1fr); }
  }
</style>

<script>
  import { mountBench } from '../scripts/bench';
  mountBench();
</script>
