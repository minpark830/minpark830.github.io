  <rect class="d-box" x="8" y="148" width="104" height="42" rx="3"/>
  <text class="d-title" x="60" y="166" text-anchor="middle">Lint, build</text>
  <text class="d-note" x="60" y="182" text-anchor="middle">CI checks</text>
  <path class="d-line d-arrow" d="M112 169H184"/>
  <rect class="d-box" x="184" y="148" width="116" height="42" rx="3"/>
  <text class="d-title" x="242" y="166" text-anchor="middle">Deploy</text>
  <text class="d-note" x="242" y="182" text-anchor="middle">GitHub Actions</text>
  <path class="d-line d-arrow" d="M300 169H332"/>
  <rect class="d-box" x="332" y="148" width="100" height="42" rx="3"/>
  <text class="d-title" x="382" y="166" text-anchor="middle">Azure</text>
  <text class="d-note" x="382" y="182" text-anchor="middle">site and API</text>
</svg>
