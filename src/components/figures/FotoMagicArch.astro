---
interface Props { labelledby: string }
const { labelledby } = Astro.props;
---
<svg viewBox="0 0 440 200" role="img" aria-labelledby={labelledby}>
  <rect class="d-box" x="8" y="30" width="104" height="50" rx="3"/>
  <text class="d-title" x="60" y="51" text-anchor="middle">React app</text>
  <text class="d-note" x="60" y="68" text-anchor="middle">Vite</text>
  <path class="d-line d-arrow2" d="M112 55H184"/>
  <text class="d-note" x="148" y="46" text-anchor="middle">JWT auth</text>
  <rect class="d-box" x="184" y="30" width="116" height="50" rx="3"/>
  <text class="d-title" x="242" y="51" text-anchor="middle">Flask API</text>
  <text class="d-note" x="242" y="68" text-anchor="middle">OpenCV effects</text>
  <path class="d-line d-arrow2" d="M300 44L332 31"/>
  <path class="d-line d-arrow2" d="M300 66L332 80"/>
  <rect class="d-box" x="332" y="8" width="100" height="44" rx="3"/>
  <text class="d-title" x="382" y="27" text-anchor="middle">MongoDB</text>
  <text class="d-note" x="382" y="43" text-anchor="middle">user data</text>
  <rect class="d-box" x="332" y="62" width="100" height="44" rx="3"/>
