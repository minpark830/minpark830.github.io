---
// How the swarm talks: a ground laptop relays commands and positions
// between a web page and one radio bridge per drone.
interface Props { labelledby: string }
const { labelledby } = Astro.props;
---
<svg viewBox="0 0 650 252" role="img" aria-labelledby={labelledby}>
  <rect class="d-group" x="6" y="30" width="452" height="214" rx="3"/>
  <text class="d-note" x="14" y="22">Ground laptop</text>

  <rect class="d-box" x="18" y="106" width="124" height="60" rx="3"/>
  <text class="d-title" x="80" y="128" text-anchor="middle">Web page</text>
  <text class="d-note" x="80" y="145" text-anchor="middle">commands and a</text>
  <text class="d-note" x="80" y="159" text-anchor="middle">live 3D plot</text>

  <path class="d-line d-arrow2" d="M142 136H180"/>
  <text class="d-note" x="161" y="127" text-anchor="middle">HTTP</text>

  <rect class="d-box-2" x="180" y="101" width="116" height="70" rx="3"/>
  <text class="d-title" x="238" y="126" text-anchor="middle">FastAPI server</text>
  <text class="d-note" x="238" y="143" text-anchor="middle">relays commands</text>
  <text class="d-note" x="238" y="157" text-anchor="middle">and positions</text>

  <path class="d-line d-arrow2" d="M296 116H318V74H338"/>
  <path class="d-line d-arrow2" d="M296 156H318V198H338"/>
  <text class="d-note" x="326" y="140">WebSocket</text>

  <rect class="d-box" x="338" y="44" width="108" height="60" rx="3"/>
  <text class="d-title" x="392" y="66" text-anchor="middle">leader.py</text>
  <text class="d-note" x="392" y="83" text-anchor="middle">Python, cflib</text>
  <text class="d-note" x="392" y="97" text-anchor="middle">Crazyradio 2.0</text>

  <rect class="d-box" x="338" y="168" width="108" height="60" rx="3"/>
  <text class="d-title" x="392" y="190" text-anchor="middle">follower.py ×2</text>
  <text class="d-note" x="392" y="207" text-anchor="middle">Python, cflib</text>
  <text class="d-note" x="392" y="221" text-anchor="middle">a radio each</text>

  <path class="d-link d-arrow2" d="M446 74H510"/>
  <text class="d-note" x="478" y="66" text-anchor="middle">radio</text>
  <path class="d-link d-arrow2" d="M446 198H510"/>
  <text class="d-note" x="478" y="190" text-anchor="middle">radio</text>

  <rect class="d-box" x="510" y="44" width="134" height="60" rx="3"/>
  <text class="d-title" x="577" y="66" text-anchor="middle">Leader drone</text>
  <text class="d-note" x="577" y="83" text-anchor="middle">flown by leader.py</text>
  <text class="d-note" x="577" y="97" text-anchor="middle">EKF: flow, range</text>

  <rect class="d-box" x="510" y="168" width="134" height="60" rx="3"/>
  <text class="d-title" x="577" y="190" text-anchor="middle">Followers ×2</text>
  <text class="d-note" x="577" y="207" text-anchor="middle">hold offsets from</text>
  <text class="d-note" x="577" y="221" text-anchor="middle">the leader</text>
</svg>
