---
import type { Project } from '../lib/sheets';
import Figure from './Figure.astro';
import Video from './Video.astro';

interface Props {
  entry: Project;
  /** "Figure 2" or "Video 1", numbered in page order */
  label: string;
}
const { entry, label } = Astro.props;
const d = entry.data;
const sheet = d.writeup ? `/projects/${entry.id}/` : null;
// A card whose main button already opens its sheet needs no second link.
const sheetLink = sheet && !d.links.some((l) => l.href === sheet) ? sheet : null;
// The drawing morphs into the same drawing on the write-up sheet.
const transitionName = sheet ? `media-${entry.id}` : undefined;
---

<article class:list={['proj', { 'proj-wide': d.placement === 'featured', mirror: d.mirror }]} id={`project-${entry.id}`} data-roles={d.roles.join(' ')}>
  {d.media?.kind === 'figure' && (
    <Figure figure={d.media.figure} label={label} caption={d.media.caption} captionId={`cap-${entry.id}`} transitionName={transitionName} />
  )}
  {d.media?.kind === 'video' && (
    <Video youtube={d.media.youtube} title={d.media.title} label={label} caption={d.media.caption} poster={d.media.poster} transitionName={transitionName} />
  )}
  <div class="proj-head">
    <h3>{d.title}</h3>
    <span class="when">{d.when}</span>
  </div>
  <div class="proj-body">
    {d.card.map((p) => <p>{p}</p>)}
    {d.stack && <p class="stack">{d.stack}</p>}
    {(sheetLink || d.links.length > 0) && (
      <p class="proj-links">
        {sheetLink && <a href={sheetLink} data-astro-prefetch>Read the write-up</a>}
        {d.links.map((l) => (
          <a class:list={{ 'btn btn-primary': l.primary }} href={l.href} data-astro-prefetch={l.href.startsWith('/') ? '' : undefined}>
            {l.icon === 'ohm' && (
              <svg viewBox="0 0 20 20" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round"><path d="M3 15h4.5v-2.1a5.5 5.5 0 1 1 5 0V15H17"></path></svg>
            )}
            {l.label}
          </a>
        ))}
      </p>
    )}
  </div>
</article>

<style>
  .proj { min-width: 0; padding-bottom: 64px; }
  /* Line up drawing, heading, and text across each row of cards. */
  @supports (grid-template-rows: subgrid) {
    .proj { display: grid; grid-row: span 3; grid-template-rows: subgrid; row-gap: 0; align-content: start; }
  }
  .proj-head { display: flex; flex-wrap: wrap; justify-content: space-between; align-items: baseline; gap: 2px 16px; margin-top: 20px; }
  h3 { font-size: var(--fs-h3); line-height: 1.3; margin: 0; letter-spacing: -0.012em; }
  .proj-body p { margin: 8px 0 0; max-width: 68ch; }
  .stack { font-size: 14px; color: var(--fg-3); }
  .proj-links { display: flex; flex-wrap: wrap; align-items: center; gap: 6px 24px; margin-top: 12px !important; font-weight: 700; font-size: 15px; }

  /* the featured project spans both columns: drawing left, text right */
  .proj-wide {
    grid-column: 1 / -1; grid-row: auto;
    display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); grid-template-rows: auto minmax(0, 1fr);
    column-gap: 56px; align-items: start;
  }
  .proj-wide > :global(figure) { grid-column: 1; grid-row: 1 / span 2; }
  .proj-wide .proj-head { grid-column: 2; grid-row: 1; margin-top: 0; }
  .proj-wide .proj-body { grid-column: 2; grid-row: 2; }
  .proj-wide .proj-links { margin-top: 20px !important; }
  .proj-wide.mirror > :global(figure) { grid-column: 2; }
  .proj-wide.mirror .proj-head, .proj-wide.mirror .proj-body { grid-column: 1; }

  @media (max-width: 900px) {
    .proj { padding-bottom: 52px; }
    .proj-wide { grid-template-columns: minmax(0, 1fr); grid-template-rows: none; }
    .proj-wide > :global(figure), .proj-wide .proj-head, .proj-wide .proj-body { grid-column: 1; grid-row: auto; }
    .proj-wide .proj-head { margin-top: 20px; }
  }
</style>
