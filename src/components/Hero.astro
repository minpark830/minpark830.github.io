---
import { site } from '../data/site';
import { results } from '../data/profile';
import Bench from './Bench.astro';
---

<section class="hero wrap" aria-labelledby="name">
  <div class="hero-grid">
    <div class="hero-id">
      <h1 id="name">{site.name}</h1>
      <p class="role">{site.role}</p>
      <p class="intro">
        I write control software for machines that have to move precisely. At Varian (Siemens Healthineers) I work on
        servo control and trajectory planning for radiotherapy machines. At Penn I research multi-drone payload control
        in the Kumar Lab.
      </p>
      <p class="avail">
        Finishing my M.S. in Electrical Engineering at Penn in December 2026. Looking for full-time roles in software,
        electrical, and controls engineering, from embedded and flight software to hardware design and GNC. U.S.
        citizen, eligible for security clearance, and open to relocation.
      </p>
      <div class="cta">
        <a class="btn btn-primary" href={site.resume} target="_blank" rel="noopener">
          <svg viewBox="0 0 20 20" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round"><path d="M5 2.75h6.5L15.25 6.5v10.75H5z"></path><path d="M11.5 2.75V6.5h3.75M7.75 10.5h4.5M7.75 13.5h4.5"></path></svg>
          Resume (PDF)
        </a>
        <a class="btn btn-secondary" href={`mailto:${site.email}`}>
          <svg viewBox="0 0 20 20" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round"><rect x="2.75" y="4.75" width="14.5" height="10.5" rx="1.5"></rect><path d="M3.25 5.5L10 10.75l6.75-5.25"></path></svg>
          Email me
        </a>
      </div>
      <ul class="links">
        <li><a href={site.github}>GitHub</a></li>
        <li><a href={site.linkedin}>LinkedIn</a></li>
      </ul>
    </div>

    <table class="results">
      <caption>Selected results</caption>
      <tbody>
        {results.map((r) => (
          <tr>
            <th scope="row">{r.amount}</th>
            <td>
              {r.what}
              <a href={r.where.href}>{r.where.label}</a>
            </td>
          </tr>
        ))}
      </tbody>
    </table>
  </div>

  <Bench />
</section>

<style>
  .hero { padding-top: 64px; }
  .hero-grid {
    display: grid; grid-template-columns: minmax(0, 7fr) minmax(0, 5fr);
    gap: 40px 64px; align-items: end;
  }
  .hero-id { min-width: 0; }
  h1 {
    font-size: clamp(50px, 7.4vw, 92px); line-height: 0.92; letter-spacing: -0.045em;
    margin: 0 0 0 -0.04em;
  }
  .role {
    font-size: clamp(20px, 2.2vw, 25px); line-height: 1.3; letter-spacing: -0.012em;
    color: var(--fg); margin: 16px 0 0;
  }
  .intro { font-size: var(--fs-lede); line-height: 1.6; max-width: 56ch; margin: 22px 0 0; }
  .avail { color: var(--fg-2); max-width: 60ch; margin: 14px 0 0; }
  .cta { display: flex; flex-wrap: wrap; gap: 10px; margin-top: 24px; }

  .results { border-collapse: collapse; width: 100%; font-variant-numeric: tabular-nums; }
  caption {
    caption-side: top; text-align: left; font-weight: 700; padding-bottom: 8px;
    border-bottom: 1px solid var(--fg);
  }
  th, td { text-align: left; vertical-align: baseline; padding: 10px 0; border-bottom: 1px solid var(--rule); }
  th { font-weight: 700; white-space: nowrap; padding-right: 18px; }
  td { color: var(--fg-2); font-size: 15px; line-height: 1.45; }
  td a { display: block; width: fit-content; margin-top: 3px; font-size: var(--fs-cap); }

  @media (max-width: 1040px) {
    .hero-grid { grid-template-columns: minmax(0, 1fr); }
    .results { max-width: 640px; }
  }
  @media (max-width: 640px) {
    .hero { padding-top: 36px; }
    .intro { font-size: 17px; }
    th { white-space: normal; width: 34%; }
  }
</style>
